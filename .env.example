FSTR_DB_HOST=127.0.0.1
FSTR_DB_PORT=5433
FSTR_DB_NAME=pereval_db
FSTR_DB_LOGIN=pereval_user
FSTR_DB_PASS=pereval_pass

# Alternative names are also supported by app/config.py:
# FSTR_LOGIN=pereval_user
# FSTR_PASS=pereval_pass

# Render deployment can use DATABASE_URL instead of separate FSTR_DB_* variables.
# DATABASE_URL=postgresql://user:password@host:5432/database
